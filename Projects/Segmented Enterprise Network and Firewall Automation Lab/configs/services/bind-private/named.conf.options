acl "trusted" {
    172.16.0.0/24;      // USERS
    10.10.10.0/24;      // INFRASTRUCTURE
    192.168.8.192/30;
    127.0.0.1;
};
 
options {
    directory "/var/cache/bind";
 
    listen-on { 10.10.10.11; 127.0.0.1; };
    listen-on-v6 { none; };
 
    allow-query     { trusted; };
    allow-recursion { trusted; };
    allow-transfer  { none; };
 
    forwarders { 10.10.30.12; };   // dns-public.group8 (DMZ)
    forward only;
 
    dnssec-validation no;
 
    version "not disclosed";
