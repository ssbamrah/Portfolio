options {
    directory "/var/cache/bind";
    listen-on { 10.10.30.12; 127.0.0.1; };
    listen-on-v6 { none; };
 
    allow-query     { any; };          // public: any endpoint
    recursion yes;
    allow-recursion { 10.10.10.11; 10.10.30.0/24; 127.0.0.1; };
    allow-transfer  { none; };
    forwarders { 1.1.1.1; 8.8.8.8; };
    forward only;
 
    dnssec-validation auto;
    version "not disclosed";
};
